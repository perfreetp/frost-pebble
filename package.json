{
  "name": "pv-roof-layout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:engine": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/smoke.mjs && node node_modules/.tmp/smoke.mjs",
    "test:dxf": "esbuild scripts/dxf-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/dxf-test.mjs && node node_modules/.tmp/dxf-test.mjs",
    "test": "npm run test:engine && npm run test:dxf"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dxf-parser": "^1.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
